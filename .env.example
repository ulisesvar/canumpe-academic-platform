# Copy to .env for local development. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg://canumpe:canumpe@localhost:5432/canumpe
LOG_LEVEL=INFO
ENVIRONMENT=development

# Used by compose.yml to initialize the local PostgreSQL container.
POSTGRES_USER=canumpe
POSTGRES_PASSWORD=canumpe
POSTGRES_DB=canumpe

# --- Moodle sync only ---------------------------------------------------
# In production the Moodle sync runs natively on the CANUMPE host (not in
# Docker) so it can reach Moodle's PostgreSQL on localhost without ever
# exposing it publicly — see the README's "Host-native operational
# integration jobs" section and deploy/systemd/. The values below are for
# local development/testing only (docker compose run --rm moodle-sync,
# or `python -m app.integration.moodle.sync` against a local Postgres).
#
# The public API service must NEVER receive these variables. Production
# credentials (academic_sync_moodle, read-only on Moodle;
# academic_ingest_moodle, least-privilege on the Academic DB) are created
# manually by database administrators — never by this application's code
# or migrations. See deploy/sql/ for the expected grants.
#
# Production shape (host-native, both source and destination on
# localhost, different ports since Moodle already owns 5432):
#   MOODLE_DB_URL=postgresql+psycopg://academic_sync_moodle:<secret>@127.0.0.1:5432/moodle
#   DATABASE_URL=postgresql+psycopg://academic_ingest_moodle:<secret>@127.0.0.1:5434/canumpe
MOODLE_DB_URL=postgresql+psycopg://academic_sync_moodle:changeme@127.0.0.1:5432/moodle
MOODLE_COURSE_ID=2
