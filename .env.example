# Copy to .env for local development. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg://canumpe:canumpe@localhost:5432/canumpe
LOG_LEVEL=INFO
ENVIRONMENT=development

# Used by compose.yml to initialize the local PostgreSQL container.
POSTGRES_USER=canumpe
POSTGRES_PASSWORD=canumpe
POSTGRES_DB=canumpe

# --- Moodle sync service only -----------------------------------------
# Read-only source credentials for the Moodle ingestion pipeline
# (app.integration.moodle.sync). The public API service must NEVER
# receive these — only the moodle-sync compose service does. The
# production user (academic_sync_moodle) is created and granted
# SELECT-only access directly on the Moodle database by its own
# administrators, never by this application's code or migrations.
MOODLE_DB_URL=postgresql+psycopg://academic_sync_moodle:changeme@moodle-db-host:5432/moodle
MOODLE_COURSE_ID=2
