# Template for /opt/canumpe/config/academic-platform/moodle-sync.env
#
# Copy this file to that path, fill in real secrets, then:
#   sudo chown academic-sync:academic-sync moodle-sync.env
#   sudo chmod 600 moodle-sync.env
#
# Never commit the real file. Placeholders below are not usable
# credentials.

# Moodle's own PostgreSQL, localhost-only, read-only account. Created
# manually by Moodle's administrators — the application never creates
# this user or grants it anything.
MOODLE_DB_URL=postgresql+psycopg://academic_sync_moodle:changeme@127.0.0.1:5432/moodle
MOODLE_COURSE_ID=2

# The Academic Database, localhost-only on its non-conflicting port
# (compose.prod.yml publishes it as 127.0.0.1:5434). Uses a dedicated,
# least-privilege ingest credential (academic_ingest_moodle) — see
# deploy/sql/academic_ingest_moodle_grants.example.sql — never the
# database-owner credential the API/migrate services use.
DATABASE_URL=postgresql+psycopg://academic_ingest_moodle:changeme@127.0.0.1:5434/canumpe

LOG_LEVEL=INFO
ENVIRONMENT=production
