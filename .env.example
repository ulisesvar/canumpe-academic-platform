# Copy to .env for local development. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg://canumpe:canumpe@localhost:5432/canumpe
LOG_LEVEL=INFO
ENVIRONMENT=development

# Used by compose.yml to initialize the local PostgreSQL container.
POSTGRES_USER=canumpe
POSTGRES_PASSWORD=canumpe
POSTGRES_DB=canumpe
