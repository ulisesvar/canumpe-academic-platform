# Template for /opt/canumpe/config/academic-platform/attendance-sync.env
#
# Copy this file to that path, fill in real secrets, then:
#   sudo chown academic-sync:academic-sync attendance-sync.env
#   sudo chmod 600 attendance-sync.env
#
# Never commit the real file. Placeholders below are not usable
# credentials.

# The Attendance PostgreSQL (asistencias-db-1 container, database
# "asistencia"), reachable from the host on whatever localhost port that
# container publishes. Read-only account, created manually by the
# Attendance system's administrators — the application never creates
# this user or grants it anything.
ATTENDANCE_DB_URL=postgresql+psycopg://academic_sync_attendance:changeme@127.0.0.1:5432/asistencia

# The Attendance source has no course id of its own — this resolves the
# course through the existing Moodle course source mapping
# (integration.course_sources, source_system='moodle').
ATTENDANCE_MOODLE_COURSE_ID=2

# The Academic Database, localhost-only on its non-conflicting port
# (compose.prod.yml publishes it as 127.0.0.1:5434). Uses a dedicated,
# least-privilege ingest credential (academic_ingest_attendance) — see
# deploy/sql/academic_ingest_attendance_grants.example.sql — never the
# database-owner credential the API/migrate services use.
DATABASE_URL=postgresql+psycopg://academic_ingest_attendance:changeme@127.0.0.1:5434/canumpe

LOG_LEVEL=INFO
ENVIRONMENT=production
