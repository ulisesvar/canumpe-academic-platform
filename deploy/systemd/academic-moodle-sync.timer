# Example unit — see academic-moodle-sync.service for installation steps.
#
# The schedule below is illustrative only. Production cadence is an
# operational decision (how fresh Moodle data needs to be vs. load on
# both databases) — not something this repository fixes. Adjust
# OnCalendar= to whatever the operators actually decide.

[Unit]
Description=Run the CANUMPE Moodle sync periodically

[Timer]
# Example: every 30 minutes. Change as needed.
OnCalendar=*-*-* *:0/30
# Runs a missed sync as soon as possible after the host was down/rebooted,
# instead of silently skipping it until the next scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
